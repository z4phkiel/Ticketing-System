# Copy to backend/.env (or set in the Render dashboard). Names only, never commit real values.
# Locally the backend also reads the project-root .env, so gemini_key and projectId there work as-is.

AI_PROVIDER=openai_compatible          # openai_compatible (Gemini, OpenAI, Groq...) or claude
gemini_key=                            # Gemini API key (secret). AI_API_KEY overrides it if set.
AI_MODEL=gemini-3.5-flash,gemini-flash-latest   # primary, then fallback(s)
AI_REASONING_EFFORT=low                # empty for providers that reject it
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

FIREBASE_CREDENTIALS_JSON=             # service-account JSON content, or a path (relative paths start in backend/) (secret)
FIREBASE_PROJECT_ID=                   # defaults to projectId from the root .env
DATA_STORE=firestore                   # memory = no Firestore, data lost on restart (local demo only)

FRONTEND_ORIGINS=                      # comma-separated; defaults to localhost:5000 + <project>.web.app
AUTO_RESOLVE_THRESHOLD=0.8
ESCALATION_PRIORITY=4
DUPLICATE_MIN_SCORE=0.25
DUPLICATE_FALLBACK_SCORE=0.75
REPLIES_PER_MINUTE=30                  # chat messages per user per minute
